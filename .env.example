OPENROUTER_API_KEY=

# Only needed to run the specialists. market_intel and team_signals build a
# ChatGoogleGenerativeAI client at MODULE level, so backend.graph cannot be
# imported at all without some value here - tests/conftest.py sets a placeholder
# so the offline suite doesn't need a real one.
# Inconsistent with the rest of the pipeline, which goes through OpenRouter
# (screen, write_memo, the evaluator's support check). Worth reconciling with
# roles B/C: porting those two specialists to OpenRouter would remove this key
# from the project entirely.
GOOGLE_API_KEY=

TAVILY_API_KEY=

FIRECRAWL_API_KEY=

LANGCHAIN_API_KEY=

LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=vc-agent